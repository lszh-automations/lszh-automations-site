# EXPERIMENTAL ONLY. Never replace canonical G3 Dockerfile without a new review.
# Requires one SHA-verified and Alpine-apk-verified local zlib APK in build context.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
WORKDIR /srv
RUN --mount=type=bind,source=zlib-1.3.2-r1.apk,target=/tmp/zlib-1.3.2-r1.apk,readonly \
    apk --no-network verify /tmp/zlib-1.3.2-r1.apk && \
    apk --no-network --no-scripts --no-commit-hooks add /tmp/zlib-1.3.2-r1.apk && \
    apk -v info | grep -Fx "zlib-1.3.2-r1" && \
    test -d /usr/local/lib/node_modules/npm && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack && \
    rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
COPY --chown=node:node index.mjs /srv/index.mjs
ENV NODE_ENV=production
USER node
EXPOSE 8080
CMD ["node","/srv/index.mjs"]
