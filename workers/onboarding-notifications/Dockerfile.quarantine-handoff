# Isolated private quarantine receiver, separate from existing outbox and website.
# Built from repository root. No runtime secrets, Git history or customer files.
FROM node:22.16.0-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --chown=node:node onboarding/confirmation.js onboarding/confirmation.js
COPY --chown=node:node workers/onboarding-notifications/airtable-candidates.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/draft-review-gate.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/outbox.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/firestore-store.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/firestore-quarantine-cas.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-plan.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-cas-offline-cycle.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/firestore-scoped-readers.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-protocol.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-offline-flow.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-replay-cas.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-http-contract.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-replay-runtime.js workers/onboarding-notifications/
COPY --chown=node:node workers/onboarding-notifications/quarantine-handoff-receiver.js workers/onboarding-notifications/
USER node
EXPOSE 8080
CMD ["node","workers/onboarding-notifications/quarantine-handoff-receiver.js"]
