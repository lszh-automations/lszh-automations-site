# Completely separate one-shot read-only STAGING probe: no outbox HTTP,
# no Firestore client, no mail code, no Airtable PAT in the image.
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY onboarding/confirmation.js /app/onboarding/confirmation.js
COPY workers/onboarding-notifications/staging-airtable-rest-read.js /app/workers/onboarding-notifications/staging-airtable-rest-read.js
COPY workers/onboarding-notifications/airtable-runtime-probe.js /app/workers/onboarding-notifications/airtable-runtime-probe.js
USER node
CMD ["node","/app/workers/onboarding-notifications/airtable-runtime-probe.js"]
