# Build context must be the sibling cloud-run/ directory.
# Only the isolated Cloud Run offer-portal can use this image.
# DO NOT deploy or expose the service without staging safety review.
FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app/offer-portal-staging
COPY offer-portal-staging/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY offer-portal-staging/*.mjs ./
COPY archive-reader-staging/archiveBundleVerifier.mjs ../archive-reader-staging/archiveBundleVerifier.mjs
USER node
EXPOSE 8080
CMD ["npm", "start"]
